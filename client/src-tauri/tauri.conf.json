{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pier",
  "version": "0.7.0",
  "identifier": "app.devbox.client",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Pier",
        "width": 1280,
        "height": 800,
        "minWidth": 760,
        "minHeight": 480,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEwODNDNkEzNjBBODkzRDYKUldUV2s2aGdvOGFEb0dOaWtYTXprM2Y2Mk5CZWlRVmNMNWxhd2RRUDRZZnFmeEhNTVk1ZWlIaTgK",
      "requireSignedVersion": true,
      "endpoints": [
        "https://github.com/superbagel9079/pier/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
